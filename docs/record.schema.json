{
  "type": "object",
  "additionalProperties": false,
  "required": ["case_note", "student_summary", "sevis_checklist", "open_questions"],
  "properties": {
    "case_note": {
      "type": "object", "additionalProperties": false,
      "required": ["facts_stated_by_student", "advice_given", "regulatory_basis"],
      "properties": {
        "facts_stated_by_student": { "type": "array", "items": { "type": "string" } },
        "advice_given": { "type": "array", "items": { "type": "string" } },
        "regulatory_basis": { "type": "array", "items": {
          "type": "object", "additionalProperties": false,
          "required": ["claim", "citation", "source_id"],
          "properties": {
            "claim": { "type": "string" },
            "citation": { "type": "string", "description": "e.g. 8 CFR 214.2(f)(10)(i)" },
            "source_id": { "type": "string", "description": "HenryKnows source id returned by search_sources; never invented" }
          } } }
      }
    },
    "student_summary": { "type": "string", "description": "Plain language, second person, no citations, no legal conclusions beyond what the adviser said" },
    "sevis_checklist": { "type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["action", "deadline", "deadline_source", "owner"],
      "properties": {
        "action": { "type": "string" },
        "deadline": { "type": "string", "description": "ISO date from compute_dates, or 'none'" },
        "deadline_source": { "type": "string", "description": "compute_dates rule id; never a model estimate" },
        "owner": { "type": "string", "enum": ["adviser", "student", "both"] }
      } } },
    "open_questions": { "type": "array", "items": { "type": "string" } }
  }
}
